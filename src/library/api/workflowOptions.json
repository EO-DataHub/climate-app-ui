[
  {
    "title": "Land Surface Temperature (LST) - Monthly (avg), Day & Night",
    "description": "This workflow provides monthly average daytime and nighttime land surface temperature observations for specified assets across the World, derived from the Sentinel Sea and Land Surface Temperature Radiometer (SLSTR). Data is available from 1st January 2016 onwards.",
    "constraints": {
      "supported_assets": [
        "Point",
        "Polygon",
        "LineString"
      ],
      "required_columns": [
        "latitude",
        "longitude"
      ]
    },
    "preset_inputs": {
      "workflow": "lst-min-max",
      "stac_catalog": "https://staging.eodatahub.org.uk/api/catalogue/stac/catalogs/user/catalogs/sparkgeouser/catalogs/processing-results/catalogs/minimalist-stac/catalogs/cat_0721004e-fe8a-11ef-a4fd-925b27b1cd31",
      "stac_collection": "['esacci-lst-s3b-night-monthly', 'esacci-lst-s3b-day-monthly', 'esacci-lst-s3a-night-monthly', 'esacci-lst-s3a-day-monthly']",
      "extra_args": "{'output_name': \"{datetime_string[:-9]}_{file_name.split('_')[2].split('-')[0]}_S3{file_name.split('-')[4][-1]}_MONTHLY\",'variable':'lst','unit':'°C','expression':'x - 273.15'}"
    },
    "user_inputs": {
      "assets": {
        "type": "file",
        "file_type": "geojson",
        "label": "Upload your asset GeoJSON file"
      },
      "start_date": {
        "label": "Select the start date",
        "type": "date",
        "default": "2022-01-01"
      },
      "end_date": {
        "label": "Select the end date",
        "type": "date",
        "default": "2022-12-31"
      }
    }
  },
