[
  {
    "title": "Land Surface Temperature (LST) - World, Day",
    "description": "This workflow provides daytime land surface temperature observations for specified assets across the World, from the Sentinel Sea and Land Surface Temperature Radiometer (SLSTR). Data is available from 1st January 2016 onwards.",
    "constraints": {
      "supported_assets": ["Point", "Polygon", "LineString"],
      "required_columns": ["latitude", "longitude"]
    },
    "preset_inputs": {
      "workflow": "lst-filter",
      "stac_catalog": "https://api.stac.ceda.ac.uk",
      "stac_collection": "['eocis-lst-s3b-day', 'eocis-lst-s3a-day']",
      "extra_args": "{'output_name': \"{datetime_string[:-9]}_{file_name.split('_')[3].split('-')[0]}_S3{file_name.split('_')[1].split('-')[4][5]}\",'variable':'lst','unit':'°C','expression':'x - 273.15'}"
    },
    "user_inputs": {
      "assets": {
        "type": "file",
        "file_type": "geojson",
        "label": "Upload your asset GeoJSON file"
      },
      "start_date": {
        "label": "Select the start date",
        "type": "date",
        "default": "2024-07-01"
      },
      "end_date": {
        "label": "Select the end date",
        "type": "date",
        "default": "2024-07-31"
      }
    }
  },
